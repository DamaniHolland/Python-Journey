'''

9-1. Restaurant: Make a class called Restaurant . The __init__() method for 
Restaurant should store two attributes: a restaurant_name and a cuisine_type . 
Make a method called describe_restaurant() that prints these two pieces of 
information, and a method called open_restaurant() that prints a message indi-
cating that the restaurant is open .Make an instance called restaurant from your class . Print the two attri-
butes individually, and then call both methods

'''

class Restaurant():
    
    def __init__(self, restaurant_name, cuisine_type):
        self.restaurant_name = restaurant_name
        self.cuisine_type = cuisine_type
        
    def describe_restaurant(self):
        print("Restaurant name: " + self.restaurant_name.title())
        print("Type of cuisine: " + self.cuisine_type.title())
        
    def open_restaurant(self):
        print("\n---Congradulations!!!---")
        print(self.restaurant_name.title() + " is officially open for business.")
        
restaurant = Restaurant("the laughing cow", 'american cuisine')




print("Restaurant name : " + restaurant.restaurant_name.title())
print("Cuisine type : " + restaurant.cuisine_type.title())

restaurant.describe_restaurant()
restaurant.open_restaurant()
